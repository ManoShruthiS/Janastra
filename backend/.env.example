# Gnani AI Prisma v3.0 Configuration
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE_CODE=indic-auto

# Translation Service Configuration
# Default engine: deep_translator (supports Google Translate / MyMemory without API key)
# Optional alternative engines: bhashini, openai, google_cloud
TRANSLATION_ENGINE=deep_translator
GOOGLE_TRANSLATE_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
